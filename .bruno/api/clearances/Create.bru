meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{api_domain}}/clearances
  body: json
  auth: inherit
}

body:json {
  {
    "faculty_id": 1, // faculty_id
    "items": [
      {
        "waste_category_id": 3,
        "waste_type_id": 4,
        "clearance_weight": 10
      },
      {
        "waste_category_id": 4,
        "waste_type_id": 6,
        "clearance_weight": 1
      }
    ]
  }
}

body:form-urlencoded {
  faculty_id: 2
  waste_clearance_period_start: 2025-12-01
  waste_clearance_period_end: 2025-12-30
}

vars:pre-request {
  api_domain: http://localhost:8000/api
}

settings {
  encodeUrl: true
  timeout: 0
}
